# Python environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets and local configuration
.env
.env.*

# macOS and notebooks
.DS_Store
.ipynb_checkpoints/

# Raw datasets: keep local, do not commit by default
data/raw/*
!data/raw/.gitkeep

# Local documentation backups
README.backup.md

# Processed datasets: keep local pending redistribution review
data/processed/*
!data/processed/.gitkeep
